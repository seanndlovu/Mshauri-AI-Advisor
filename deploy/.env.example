# ── Copy this file to .env.production and fill in real values ────
# Database
DATABASE_URL=postgresql://mshauri:YOUR_DB_PASSWORD@localhost:5432/mshauri
DB_NAME=mshauri
DB_USER=mshauri
DB_PASS=YOUR_DB_PASSWORD

# App
NODE_ENV=production
PORT=8080
DOMAIN=your-domain.com

# Auth
SESSION_SECRET=replace-with-a-long-random-string-at-least-32-characters

# OpenAI (for AI chat)
OPENAI_API_KEY=sk-...

# WhatsApp Business API (optional — only needed for WhatsApp bot)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
