# ─────────────────────────────────────────────────────────────────
# Mshauri — Production environment variables
# Copy this file to .env.production and fill in your values
# Usage: cp deploy/.env.example deploy/.env.production
# ─────────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────────
PORT=8080
NODE_ENV=production

# ── Domain (your subdomain, no https://) ─────────────────────────
DOMAIN=mshauri.marichomedia.com

# ── Database ─────────────────────────────────────────────────────
DB_NAME=mshauri
DB_USER=mshauri
DB_PASS=change_this_to_a_strong_password
# DATABASE_URL is created automatically by the deployment scripts.

# ── Session (any long random string — keep it secret) ────────────
SESSION_SECRET=replace_with_a_long_random_string_at_least_64_chars

# ── First Owner bootstrap ──────────────────────────────────────────
# Set this to the trusted first Owner's verified Clerk/Google email.
# After they sign in, they visit /admin/staff and claim Owner access once.
# All later Owner, Market Price Editor, and Ad Manager changes happen there.
OWNER_BOOTSTRAP_EMAIL=owner@example.com

# ── Ad uploads ─────────────────────────────────────────────────────
# Keep advert creatives outside the Git checkout so updates never remove active uploads.
ADS_UPLOAD_DIR=/var/lib/mshauri/ads

# ── OpenAI (optional: required only for Ask Mshauri AI chat) ─────
OPENAI_API_KEY=sk-...

# ── WhatsApp Business API (optional: required only for WhatsApp) ─
WHATSAPP_ACCESS_TOKEN=your_never_expiring_system_user_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_VERIFY_TOKEN=any_string_you_choose_for_webhook_verification
