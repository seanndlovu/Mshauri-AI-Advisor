# ─────────────────────────────────────────────────────────────────
# Mshauri — Production environment variables
# Copy this file to .env.production and fill in your values
# Usage: cp deploy/.env.example deploy/.env.production
# ─────────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────────
PORT=8080
NODE_ENV=production

# ── Domain (your subdomain, no https://) ─────────────────────────
DOMAIN=mshauri.marichomedia.com

# ── Database ─────────────────────────────────────────────────────
DB_NAME=mshauri
DB_USER=mshauri
DB_PASS=change_this_to_a_strong_password
DATABASE_URL=postgresql://mshauri:change_this_to_a_strong_password@localhost:5432/mshauri

# ── Session (any long random string — keep it secret) ────────────
SESSION_SECRET=replace_with_a_long_random_string_at_least_64_chars

# ── OpenAI (for Ask Mshauri AI chat) ─────────────────────────────
OPENAI_API_KEY=sk-...

# ── WhatsApp Business API (from Meta Business Manager) ────────────
WHATSAPP_ACCESS_TOKEN=your_never_expiring_system_user_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_VERIFY_TOKEN=any_string_you_choose_for_webhook_verification
